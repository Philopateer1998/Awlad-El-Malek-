---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const items = await getCollection('materials');
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Base title={entry.data.title}>
  <div class="container">
    <p class="crumbs"><a href="/materials">مواد الخدمة</a> / {entry.data.title}</p>
    <article class="article">
      <h1>{entry.data.title}</h1>
      {entry.data.kind && <p><span class="chip">{entry.data.kind}</span></p>}
      {entry.data.cover && <img src={entry.data.cover} alt={entry.data.title} />}
      <Content />
      <Gallery images={entry.data.gallery} />
    </article>
  </div>
</Base>
